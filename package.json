{
    "name": "@noburi/nodemailer",
    "version": "0.1.2",
    "description": "Nodemailer transport for PulseSend: send through the PulseSend API without changing your Nodemailer code.",
    "keywords": [
        "email",
        "nodemailer",
        "pulsesend",
        "transactional",
        "transport"
    ],
    "homepage": "https://github.com/usenoburi/pulsesend-nodemailer#readme",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/usenoburi/pulsesend-nodemailer.git"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "nodemailer": "10.4.1",
        "tsdown": "^0.23.5",
        "typescript": "^5.9.3",
        "vitest": "^4.1.12"
    },
    "peerDependencies": {
        "nodemailer": ">=6.9"
    },
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@12.21.0"
}
